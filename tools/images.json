{
  "source": "https://github.com/helius-labs/zolana-custom-rings",
  "services": {
    "ring-rpc": {
      "repository": "zolana-ring-rpc",
      "context": ".",
      "file": "services/ring-rpc/Dockerfile",
      "title": "Zolana Ring RPC",
      "description": "Zolana custom ring audit RPC",
      "smoke": "docker run --rm \"$image\" --help >/dev/null && test \"$(docker run --rm --entrypoint id \"$image\" -u)\" = 10002"
    },
    "ring-indexer": {
      "repository": "zolana-ring-indexer",
      "context": ".",
      "file": "services/ring-indexer/Dockerfile",
      "title": "Zolana Ring Indexer",
      "description": "Zolana custom ring indexer beside Photon",
      "smoke": "docker run --rm \"$image\" --help >/dev/null && test \"$(docker run --rm --entrypoint id \"$image\" -u)\" = 10003"
    },
    "ring-prover": {
      "repository": "zolana-ring-prover",
      "context": "zolana/prover/server",
      "file": "zolana/prover/server/Dockerfile.light",
      "title": "Zolana Ring Prover",
      "description": "Zolana Groth16 proving server with the custom ring circuits",
      "smoke": "docker run --rm \"$image\" --help >/dev/null"
    }
  }
}
